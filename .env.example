# Copier ce fichier en .env (à la racine pour Docker, ou dans server/ sans Docker)

# Mot de passe du compte admin du CEDTI (modération des signalements).
# À CHANGER : tant que la valeur d'exemple ci-dessous est en place, le serveur
# refuse toute connexion à l'espace admin.
ADMIN_PASSWORD=changez-moi

# --- Production (Docker + Caddy) ---
# Nom de domaine public : Caddy obtient le certificat HTTPS automatiquement
DOMAIN=geomaurice.exemple.mu
# 1 derrière Caddy (production), 0 en local
TRUST_PROXY=0

# --- Future application mobile native (Capacitor, etc.) ---
# Origines autorisées à appeler l'API, séparées par des virgules
CORS_ORIGINS=

# --- Facultatif ---
# Nombre maximal de signalements par heure et par adresse IP (30 par défaut).
# Les réseaux mobiles partagent souvent une IP entre abonnés : ne pas trop baisser.
# REPORTS_PER_HOUR=30
# Port local de l'application (Docker : publié sur 127.0.0.1 uniquement)
APP_PORT=3000
